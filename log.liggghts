# ---------------------------
# SAFETY ALIASES FOR INCLUDED FILE
# Ensure any group names that magnetic_field_apply.lmp expects exist
# If the included file tries to delete a group by name, LAMMPS will not error
# with "Could not find delete_atoms group ID" if the name exists (even if empty).
# ---------------------------

# Create aliases for the temporary groups we print earlier (make sure they exist)
group _temp_type1 type 1
629 atoms in group _temp_type1
group _temp_type2 type 2
17 atoms in group _temp_type2
group _temp_type3 type 3
1 atoms in group _temp_type3
group _temp_type4 type 4
