# Common alias names that included scripts sometimes use — create them as empty groups
# so delete_atoms will find the name (if the include expects to delete a group).
# Safe dummy groups so delete_atoms finds them if referenced
group field_delete type 5
0 atoms in group field_delete
group delete_group type 5
0 atoms in group delete_group
group magnet_delete type 5
