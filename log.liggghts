# Initialize magnetic field variables to exactly zero
variable fx_mag atom 0.0
variable fy_mag atom 0.0
variable fz_mag atom 0.0
variable fx_mag_viz atom 0.0
variable fy_mag_viz atom 0.0
variable fz_mag_viz atom 0.0
variable B_magnitude atom 0.0
variable B_gradient_mag atom 0.0

# Update dump to include field visualization
dump    dust_viz all custom/vtk 1000 post/lunar_dust_*.vtk         id type x y z ix iy iz vx vy vz fx fy fz         omegax omegay omegaz radius         v_fx_mag_viz v_fy_mag_viz v_fz_mag_viz         v_B_magnitude v_B_gradient_mag

# After first 100k steps, reduce output frequency
dump_modify dust_viz every 1000

#=============================================================================
# PHASE 1: LUNAR DUST DEPOSITION AND SETTLING
#=============================================================================

