# Include the magnetic field commands
include magnetic_field_apply.lmp
# ==========================================================================
# MAGNETIC FIELD APPLICATION - SCIENTIFICALLY ACCURATE
# Auto-generated from FEM and DEM configuration files
# Force update frequency: every 100 timesteps
# ==========================================================================


# === NEIGHBOR LIST PRE-CONFIGURATION ===
# Increase capacity before creating visualization atoms
# Visualization atoms: 1292 (subsampled from 102×114)
neigh_modify one 10000
neigh_modify page 200000

print "==================================================================================="
===================================================================================
print "ACTIVATING MAGNETIC FIELD (SCIENTIFICALLY ACCURATE PHYSICS)"
ACTIVATING MAGNETIC FIELD (SCIENTIFICALLY ACCURATE PHYSICS)
print "==================================================================================="
===================================================================================

# === FUNDAMENTAL CONSTANTS ===
variable mu0 equal 1.256637062120e-06  # Vacuum permeability [H/m]
variable force_mult equal 1.000000e+03
variable calc_freq equal 100
variable damping_gamma equal 1.737629e-02

# === PHYSICS NOTES ===
# All particles are DIAMAGNETIC (negative χ)
# Particles are REPELLED from high-field regions
# Force formula: F = (χ·V/μ₀)·(B·∇)B
# where (B·∇)B is the magnetic force gradient

# === COORDINATE MAPPING (DEM → FEM) ===
# DEM domain: X=[-0.0550, 0.0550], Y=[-0.0550, 0.0550] m
# FEM domain: X=[-0.0500, 0.0510], Y=[-0.0500, 0.0630] m
# Transformation: X_FEM = scale * X_DEM + offset
variable scale_x equal 1.089108910891
variable scale_y equal 0.973451327434
variable offset_x equal 0.000500000000
variable offset_y equal 0.006500000000

# === FIELD APPROXIMATION ===
# 42-peak Gaussian approximation (dynamically selected)
# Peak selection: 5% threshold, 6.0 mm min separation
# Peak width: 3.0 mm (3× FEM grid spacing)
# Field coverage: ~71.8% of gradient energy

# Peak 1 at FEM=(0.0400, -0.0180) m
variable peak0_x equal 0.040000000000
variable peak0_y equal -0.018000000000
variable peak0_gradBx equal -2.536530422864e+04
variable peak0_gradBy equal 2.532375037218e+04
variable peak0_width equal 0.003000000000

variable dx0 atom "(x*v_scale_x+v_offset_x)-v_peak0_x"
variable dy0 atom "(y*v_scale_y+v_offset_y)-v_peak0_y"
variable r2_0 atom "v_dx0*v_dx0+v_dy0*v_dy0"
variable gauss0 atom "exp(-v_r2_0/(2*v_peak0_width*v_peak0_width))"
variable gBx0 atom "v_peak0_gradBx*v_gauss0"
variable gBy0 atom "v_peak0_gradBy*v_gauss0"

# Peak 2 at FEM=(0.0500, -0.0380) m
variable peak1_x equal 0.050000000000
