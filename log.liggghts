# Total: 1292 visualization particles created

# Group visualization particles
group field_viz type 5
1190 atoms in group field_viz

# === MAKE VISUALIZATION PARTICLES PARAMAGNETIC ===
# Type 5 has POSITIVE χ → attracted to high-field regions
# This causes natural clustering at coil edges/peaks
variable chi_viz equal 3.500000000e-01  # Paramagnetic
variable r_viz equal 1.000000000e-04      # 100 μm radius
variable V_viz equal 4.188790204786e-12     # Volume
variable coeff_viz equal 1.166666666032e-03  # χ·V/μ₀

# Visualization particles experience magnetic force
variable fx_viz_mag atom "v_coeff_viz*v_BgradB_x*v_force_mult"
variable fy_viz_mag atom "v_coeff_viz*v_BgradB_y*v_force_mult"
fix mag_viz_force field_viz addforce v_fx_viz_mag v_fy_viz_mag 0.0

# Heavy damping for fast convergence to equilibrium
variable damping_viz equal 8.688142684e-03
variable vx_damp_viz atom "-v_damping_viz*vx"
variable vy_damp_viz atom "-v_damping_viz*vy"
fix damp_viz_force field_viz addforce v_vx_damp_viz v_vy_damp_viz 0.0

# Keep visualization particles on XY plane
fix freeze_viz_z field_viz setforce NULL NULL 0.0
velocity field_viz set NULL NULL 0.0

# === INTER-PARTICLE REPULSION (prevents overlap) ===
# Short-range repulsion keeps particles from clustering too tightly
variable r_cutoff equal 0.0003  # 0.3 mm cutoff
variable k_repel equal 1.0e-6   # Repulsion strength

# === VISUALIZATION PARTICLE BEHAVIOR ===
# Chi: 3.50e-01 (PARAMAGNETIC - attracted to high field)
# Expected behavior:
#   1. Initially spread uniformly
#   2. Drift toward high-field regions (coil edges)
#   3. Form dense clusters at peaks
#   4. Sparse in low-field areas (coil center)
#   5. Final distribution shows field structure

# Particle dynamics:
#   Max force: 4.18e+01 N
#   Equilibrium velocity: 4813036.8 mm/s
#   Settling time: ~0.0 seconds

# === VALIDATION METRICS ===
# Check these in ParaView to verify field is working:
#   1. Type 5 particles should MOVE during Phase 2
#   2. Final density highest at coil edges (field peaks)
#   3. Low density in coil center (low field)
#   4. If particles don't move → field not being applied!

# Visualization plane:
#   Z: 0.000100 m (just above bottom wall)
#   X: [-0.0500, 0.0510] m
#   Y: [-0.0500, 0.0630] m

print "✓ Magnetic field successfully activated!"
✓ Magnetic field successfully activated!
print "  - Force formula: F = (χ·V/μ₀)·(B·∇)B"
  - Force formula: F = (χ·V/μ₀)·(B·∇)B
print "  - Update frequency: every 100 timesteps"
  - Update frequency: every 100 timesteps
print "  - Velocity damping: γ = 1.74e-02"
  - Velocity damping: γ = 1.74e-02
print "  - VTK variables: v_fx_mag, v_fy_mag, v_fz_mag"
  - VTK variables: v_fx_mag, v_fy_mag, v_fz_mag
print "  - Diagnostic variables: v_x_mapped, v_y_mapped, v_grad_check"
  - Diagnostic variables: v_x_mapped, v_y_mapped, v_grad_check

# Update thermodynamic output to track forces
thermo_style custom step atoms ke c_rke vol c_fx_sum_t4 c_fy_sum_t4 v_ramp_pct
