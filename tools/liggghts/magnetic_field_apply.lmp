# ==========================================================================
# LIGGGHTS MAGNETIC FIELD WITH COMPREHENSIVE DEBUGGING
# Grid: 102×110 = 11220 regions
# ==========================================================================

# ==========================================================================
# DEBUG: INITIAL SYSTEM STATE
# ==========================================================================
print '==============================================================================='
print 'DEBUG: PRE-MAGNETIC FIELD SYSTEM STATE'
print '==============================================================================='
variable n_atoms equal atoms
variable dt_val equal dt
variable step_val equal step
variable time_val equal time
print 'Total atoms: ${n_atoms}'
print 'Total types: 4'
print 'Timestep: ${dt_val}'
print 'Current step: ${step_val}'
print 'Simulation time: ${time_val} s'
print '-------------------------------------------------------------------------------'

# Domain boundaries
print 'Domain X: -0.055000 to 0.055000 m'
print 'Domain Y: -0.055000 to 0.055000 m'
print 'Domain Z: 0.000000 to 0.160000 m'
print '-------------------------------------------------------------------------------'

# Particle counts by type
variable n_type1 equal count(type1_particles)
print 'Type 1 particles: ${n_type1}'
variable n_type2 equal count(type2_particles)
print 'Type 2 particles: ${n_type2}'
variable n_type3 equal count(type3_particles)
print 'Type 3 particles: ${n_type3}'
variable n_type4 equal count(type4_particles)
print 'Type 4 particles: ${n_type4}'
print '-------------------------------------------------------------------------------'

# Center of mass (initial)
variable com_x_1_init equal xcm(type1_particles,x)
variable com_y_1_init equal xcm(type1_particles,y)
variable com_z_1_init equal xcm(type1_particles,z)
print 'Type 1 COM (initial): (${com_x_1_init}, ${com_y_1_init}, ${com_z_1_init}) m'
variable com_x_2_init equal xcm(type2_particles,x)
variable com_y_2_init equal xcm(type2_particles,y)
variable com_z_2_init equal xcm(type2_particles,z)
print 'Type 2 COM (initial): (${com_x_2_init}, ${com_y_2_init}, ${com_z_2_init}) m'
variable com_x_3_init equal xcm(type3_particles,x)
variable com_y_3_init equal xcm(type3_particles,y)
variable com_z_3_init equal xcm(type3_particles,z)
print 'Type 3 COM (initial): (${com_x_3_init}, ${com_y_3_init}, ${com_z_3_init}) m'
variable com_x_4_init equal xcm(type4_particles,x)
variable com_y_4_init equal xcm(type4_particles,y)
variable com_z_4_init equal xcm(type4_particles,z)
print 'Type 4 COM (initial): (${com_x_4_init}, ${com_y_4_init}, ${com_z_4_init}) m'
print '-------------------------------------------------------------------------------'

# Average velocities (initial) - skipped due to LIGGGHTS limitations
print 'Velocity statistics available in thermo output'
print '-------------------------------------------------------------------------------'

# ==========================================================================
# DEBUG: MAGNETIC FIELD REGIONS
# ==========================================================================
print 'Defining 11220 magnetic field regions...'
print 'FEM coil center: (0.000500, 0.004500) m'
print 'DEM domain center: (0.000000, 0.000000) m'
print 'Offset applied: (0.000500, 0.004500) m'
print '-------------------------------------------------------------------------------'

