variable gBy28 atom "v_peak28_gradBy*v_gauss28"

# Peak 30 at FEM=(0.0400, -0.0400) m
variable peak29_x equal 0.040000000000
variable peak29_y equal -0.040000000000
variable peak29_gradBx equal -8.070742933031e+03
variable peak29_gradBy equal 7.237580272887e+03
variable peak29_width equal 0.003000000000

variable dx29 atom "(x*v_scale_x+v_offset_x)-v_peak29_x"
variable dy29 atom "(y*v_scale_y+v_offset_y)-v_peak29_y"
variable r2_29 atom "v_dx29*v_dx29+v_dy29*v_dy29"
variable gauss29 atom "exp(-v_r2_29/(2*v_peak29_width*v_peak29_width))"
variable gBx29 atom "v_peak29_gradBx*v_gauss29"
variable gBy29 atom "v_peak29_gradBy*v_gauss29"

# Peak 31 at FEM=(0.0500, 0.0560) m
variable peak30_x equal 0.050000000000
variable peak30_y equal 0.056000000000
variable peak30_gradBx equal -3.206973814022e+02
variable peak30_gradBy equal -7.588238554237e+03
variable peak30_width equal 0.003000000000

variable dx30 atom "(x*v_scale_x+v_offset_x)-v_peak30_x"
variable dy30 atom "(y*v_scale_y+v_offset_y)-v_peak30_y"
variable r2_30 atom "v_dx30*v_dx30+v_dy30*v_dy30"
variable gauss30 atom "exp(-v_r2_30/(2*v_peak30_width*v_peak30_width))"
variable gBx30 atom "v_peak30_gradBx*v_gauss30"
variable gBy30 atom "v_peak30_gradBy*v_gauss30"

# === TOTAL MAGNETIC FORCE FIELD ===
variable BgradB_x atom "v_gBx0 + v_gBx1 + v_gBx2 + v_gBx3 + v_gBx4 + v_gBx5 + v_gBx6 + v_gBx7 + v_gBx8 + v_gBx9 + v_gBx10 + v_gBx11 + v_gBx12 + v_gBx13 + v_gBx14 + v_gBx15 + v_gBx16 + v_gBx17 + v_gBx18 + v_gBx19 + v_gBx20 + v_gBx21 + v_gBx22 + v_gBx23 + v_gBx24 + v_gBx25 + v_gBx26 + v_gBx27 + v_gBx28 + v_gBx29 + v_gBx30"
variable BgradB_y atom "v_gBy0 + v_gBy1 + v_gBy2 + v_gBy3 + v_gBy4 + v_gBy5 + v_gBy6 + v_gBy7 + v_gBy8 + v_gBy9 + v_gBy10 + v_gBy11 + v_gBy12 + v_gBy13 + v_gBy14 + v_gBy15 + v_gBy16 + v_gBy17 + v_gBy18 + v_gBy19 + v_gBy20 + v_gBy21 + v_gBy22 + v_gBy23 + v_gBy24 + v_gBy25 + v_gBy26 + v_gBy27 + v_gBy28 + v_gBy29 + v_gBy30"

# === MAGNETIC FORCES BY PARTICLE TYPE ===
# Type 1 (pts_fine): r=20.0 μm, χ=-3.50e-05 (diamagnetic (repelled))
variable coeff_t1 equal -9.333333328252e-13  # χ·V/μ₀ [m³/H]
variable fx_mag_t1 atom "v_coeff_t1*v_BgradB_x*v_force_mult"
variable fy_mag_t1 atom "v_coeff_t1*v_BgradB_y*v_force_mult"

# Type 2 (pts_medium): r=75.0 μm, χ=-3.50e-05 (diamagnetic (repelled))
variable coeff_t2 equal -4.921874997321e-11  # χ·V/μ₀ [m³/H]
variable fx_mag_t2 atom "v_coeff_t2*v_BgradB_x*v_force_mult"
variable fy_mag_t2 atom "v_coeff_t2*v_BgradB_y*v_force_mult"

# Type 3 (pts_coarse): r=150.0 μm, χ=-3.50e-05 (diamagnetic (repelled))
variable coeff_t3 equal -3.937499997857e-10  # χ·V/μ₀ [m³/H]
variable fx_mag_t3 atom "v_coeff_t3*v_BgradB_x*v_force_mult"
variable fy_mag_t3 atom "v_coeff_t3*v_BgradB_y*v_force_mult"

# Type 4 (pts_vcoarse): r=300.0 μm, χ=-3.50e-05 (diamagnetic (repelled))
variable coeff_t4 equal -3.149999998285e-09  # χ·V/μ₀ [m³/H]
variable fx_mag_t4 atom "v_coeff_t4*v_BgradB_x*v_force_mult"
variable fy_mag_t4 atom "v_coeff_t4*v_BgradB_y*v_force_mult"


# === FORCE RAMP-UP FOR SMOOTH TRANSITION ===
# Forces gradually increase from 0 to full strength over Phase 2
# This prevents instant particle repositioning
# Ramp duration: 100,000 timesteps (1.0 seconds)
variable step_phase2_start equal 150000
variable ramp_duration equal 100000
variable ramp_time equal "(step-v_step_phase2_start)*(step>v_step_phase2_start)"
variable ramp_progress equal "v_ramp_time/v_ramp_duration*(v_ramp_time<v_ramp_duration)+1.0*(v_ramp_time>=v_ramp_duration)"

# === FORCE APPLICATION WITH SMOOTH RAMP ===
# Type 1: Magnetic force with smooth ramp + Damping
variable fx_mag_t1_ramped atom "v_fx_mag_t1*v_ramp_progress"
variable fy_mag_t1_ramped atom "v_fy_mag_t1*v_ramp_progress"
fix mag_force_t1 type1_particles addforce v_fx_mag_t1_ramped v_fy_mag_t1_ramped 0.0
variable vx_damp_t1 atom "-v_damping_gamma*vx"
variable vy_damp_t1 atom "-v_damping_gamma*vy"
fix damp_force_t1 type1_particles addforce v_vx_damp_t1 v_vy_damp_t1 0.0

# Type 2: Magnetic force with smooth ramp + Damping
variable fx_mag_t2_ramped atom "v_fx_mag_t2*v_ramp_progress"
variable fy_mag_t2_ramped atom "v_fy_mag_t2*v_ramp_progress"
fix mag_force_t2 type2_particles addforce v_fx_mag_t2_ramped v_fy_mag_t2_ramped 0.0
variable vx_damp_t2 atom "-v_damping_gamma*vx"
variable vy_damp_t2 atom "-v_damping_gamma*vy"
fix damp_force_t2 type2_particles addforce v_vx_damp_t2 v_vy_damp_t2 0.0

# Type 3: Magnetic force with smooth ramp + Damping
variable fx_mag_t3_ramped atom "v_fx_mag_t3*v_ramp_progress"
variable fy_mag_t3_ramped atom "v_fy_mag_t3*v_ramp_progress"
fix mag_force_t3 type3_particles addforce v_fx_mag_t3_ramped v_fy_mag_t3_ramped 0.0
variable vx_damp_t3 atom "-v_damping_gamma*vx"
variable vy_damp_t3 atom "-v_damping_gamma*vy"
fix damp_force_t3 type3_particles addforce v_vx_damp_t3 v_vy_damp_t3 0.0

# Type 4: Magnetic force with smooth ramp + Damping
variable fx_mag_t4_ramped atom "v_fx_mag_t4*v_ramp_progress"
variable fy_mag_t4_ramped atom "v_fy_mag_t4*v_ramp_progress"
fix mag_force_t4 type4_particles addforce v_fx_mag_t4_ramped v_fy_mag_t4_ramped 0.0
variable vx_damp_t4 atom "-v_damping_gamma*vx"
variable vy_damp_t4 atom "-v_damping_gamma*vy"
fix damp_force_t4 type4_particles addforce v_vx_damp_t4 v_vy_damp_t4 0.0

compute fx_sum_t1 _temp_type1 reduce sum v_fx_mag_t1
compute fy_sum_t1 _temp_type1 reduce sum v_fy_mag_t1
compute fx_sum_t2 _temp_type2 reduce sum v_fx_mag_t2
compute fy_sum_t2 _temp_type2 reduce sum v_fy_mag_t2
compute fx_sum_t3 _temp_type3 reduce sum v_fx_mag_t3
compute fy_sum_t3 _temp_type3 reduce sum v_fy_mag_t3
compute fx_sum_t4 _temp_type4 reduce sum v_fx_mag_t4
compute fy_sum_t4 _temp_type4 reduce sum v_fy_mag_t4

# These variables allow visualization of both forces AND field in ParaView
variable fx_mag_viz atom "(type==1)*v_fx_mag_t1_ramped + (type==2)*v_fx_mag_t2_ramped + (type==3)*v_fx_mag_t3_ramped + (type==4)*v_fx_mag_t4_ramped"
variable fy_mag_viz atom "(type==1)*v_fy_mag_t1_ramped + (type==2)*v_fy_mag_t2_ramped + (type==3)*v_fy_mag_t3_ramped + (type==4)*v_fy_mag_t4_ramped"
variable fz_mag_viz atom "0.0"  # No z-component (2D field)

# Magnetic field magnitude at each particle location
variable B_magnitude atom "sqrt(v_gauss0*v_peak0_gradBx*v_peak0_gradBx + v_gauss0*v_peak0_gradBy*v_peak0_gradBy + v_gauss1*v_peak1_gradBx*v_peak1_gradBx + v_gauss1*v_peak1_gradBy*v_peak1_gradBy + v_gauss2*v_peak2_gradBx*v_peak2_gradBx + v_gauss2*v_peak2_gradBy*v_peak2_gradBy + v_gauss3*v_peak3_gradBx*v_peak3_gradBx + v_gauss3*v_peak3_gradBy*v_peak3_gradBy + v_gauss4*v_peak4_gradBx*v_peak4_gradBx + v_gauss4*v_peak4_gradBy*v_peak4_gradBy + v_gauss5*v_peak5_gradBx*v_peak5_gradBx + v_gauss5*v_peak5_gradBy*v_peak5_gradBy + v_gauss6*v_peak6_gradBx*v_peak6_gradBx + v_gauss6*v_peak6_gradBy*v_peak6_gradBy + v_gauss7*v_peak7_gradBx*v_peak7_gradBx + v_gauss7*v_peak7_gradBy*v_peak7_gradBy + v_gauss8*v_peak8_gradBx*v_peak8_gradBx + v_gauss8*v_peak8_gradBy*v_peak8_gradBy + v_gauss9*v_peak9_gradBx*v_peak9_gradBx + v_gauss9*v_peak9_gradBy*v_peak9_gradBy + v_gauss10*v_peak10_gradBx*v_peak10_gradBx + v_gauss10*v_peak10_gradBy*v_peak10_gradBy + v_gauss11*v_peak11_gradBx*v_peak11_gradBx + v_gauss11*v_peak11_gradBy*v_peak11_gradBy + v_gauss12*v_peak12_gradBx*v_peak12_gradBx + v_gauss12*v_peak12_gradBy*v_peak12_gradBy + v_gauss13*v_peak13_gradBx*v_peak13_gradBx + v_gauss13*v_peak13_gradBy*v_peak13_gradBy + v_gauss14*v_peak14_gradBx*v_peak14_gradBx + v_gauss14*v_peak14_gradBy*v_peak14_gradBy + v_gauss15*v_peak15_gradBx*v_peak15_gradBx + v_gauss15*v_peak15_gradBy*v_peak15_gradBy + v_gauss16*v_peak16_gradBx*v_peak16_gradBx + v_gauss16*v_peak16_gradBy*v_peak16_gradBy + v_gauss17*v_peak17_gradBx*v_peak17_gradBx + v_gauss17*v_peak17_gradBy*v_peak17_gradBy + v_gauss18*v_peak18_gradBx*v_peak18_gradBx + v_gauss18*v_peak18_gradBy*v_peak18_gradBy + v_gauss19*v_peak19_gradBx*v_peak19_gradBx + v_gauss19*v_peak19_gradBy*v_peak19_gradBy + v_gauss20*v_peak20_gradBx*v_peak20_gradBx + v_gauss20*v_peak20_gradBy*v_peak20_gradBy + v_gauss21*v_peak21_gradBx*v_peak21_gradBx + v_gauss21*v_peak21_gradBy*v_peak21_gradBy + v_gauss22*v_peak22_gradBx*v_peak22_gradBx + v_gauss22*v_peak22_gradBy*v_peak22_gradBy + v_gauss23*v_peak23_gradBx*v_peak23_gradBx + v_gauss23*v_peak23_gradBy*v_peak23_gradBy + v_gauss24*v_peak24_gradBx*v_peak24_gradBx + v_gauss24*v_peak24_gradBy*v_peak24_gradBy + v_gauss25*v_peak25_gradBx*v_peak25_gradBx + v_gauss25*v_peak25_gradBy*v_peak25_gradBy + v_gauss26*v_peak26_gradBx*v_peak26_gradBx + v_gauss26*v_peak26_gradBy*v_peak26_gradBy + v_gauss27*v_peak27_gradBx*v_peak27_gradBx + v_gauss27*v_peak27_gradBy*v_peak27_gradBy + v_gauss28*v_peak28_gradBx*v_peak28_gradBx + v_gauss28*v_peak28_gradBy*v_peak28_gradBy + v_gauss29*v_peak29_gradBx*v_peak29_gradBx + v_gauss29*v_peak29_gradBy*v_peak29_gradBy + v_gauss30*v_peak30_gradBx*v_peak30_gradBx + v_gauss30*v_peak30_gradBy*v_peak30_gradBy)"

variable B_gradient_mag atom "sqrt(v_BgradB_x*v_BgradB_x + v_BgradB_y*v_BgradB_y)"

# === DIAGNOSTIC VARIABLES ===
# Use these to verify coordinate mapping and field interpolation
variable x_mapped atom "x*v_scale_x+v_offset_x"  # DEM→FEM X coordinate
variable y_mapped atom "y*v_scale_y+v_offset_y"  # DEM→FEM Y coordinate
variable grad_check atom "sqrt(v_BgradB_x*v_BgradB_x+v_BgradB_y*v_BgradB_y)"  # Field gradient magnitude

# Grid: 101 × 113 visualization points
# Creating via region + lattice for efficiency

# Group field_viz will be created after atoms are added
# Create dummy atoms at FEM grid points for visualization

# === FIELD GRID FOR VISUALIZATION ===
region field_viz_region block -0.05050000 0.05150000 -0.05050000 0.06350000 0.075 0.076 units box
lattice sc 0.00100000
create_atoms 5 region field_viz_region
lattice none 1.0  # Reset lattice

# Freeze visualization particles
group field_viz type 5
fix freeze_viz field_viz setforce 0.0 0.0 0.0
velocity field_viz set 0.0 0.0 0.0

# === MAGNETIC FIELD GEOMETRY VISUALIZATION ===
# Type 5 particles show the actual magnetic field structure
# These are frozen in space and colored by field strength

# Coil positioned on bottom wall:
#   X: [-0.0500, 0.0510] m (10.1 cm wide)
#   Y: [-0.0500, 0.0630] m (11.3 cm wide)
#   Z: 0.0000 m (on bottom wall)

# In ParaView:
#   1. Filter by 'type == 5' to see only field visualization
#   2. Color by 'v_B_magnitude' to see field strength
#   3. Add Glyph (arrows) using v_fx_mag_viz, v_fy_mag_viz
#   4. Filter by 'type != 5' to see only real particles

print "✓ Magnetic field successfully activated!"
print "  - Force formula: F = (χ·V/μ₀)·(B·∇)B"
print "  - Update frequency: every 100 timesteps"
print "  - Velocity damping: γ = 1.74e-03"
print "  - VTK variables: v_fx_mag, v_fy_mag, v_fz_mag"
print "  - Diagnostic variables: v_x_mapped, v_y_mapped, v_grad_check"
