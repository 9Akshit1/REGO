# ==========================================================================
# MAGNETIC FIELD APPLICATION - SCIENTIFICALLY ACCURATE
# Auto-generated from FEM and DEM configuration files
# Force update frequency: every 100 timesteps
# ==========================================================================

print "==================================================================================="
print "ACTIVATING MAGNETIC FIELD (SCIENTIFICALLY ACCURATE PHYSICS)"
print "==================================================================================="

# === FUNDAMENTAL CONSTANTS ===
variable mu0 equal 1.256637062120e-06  # Vacuum permeability [H/m]
variable force_mult equal 1.000000e+01
variable calc_freq equal 100
variable damping_gamma equal 1.737629e-03

# === PHYSICS NOTES ===
# All particles are DIAMAGNETIC (negative χ)
# Particles are REPELLED from high-field regions
# Force formula: F = (χ·V/μ₀)·(B·∇)B
# where (B·∇)B is the magnetic force gradient

# === COORDINATE MAPPING (DEM → FEM) ===
# DEM domain: X=[-0.0550, 0.0550], Y=[-0.0550, 0.0550] m
# FEM domain: X=[-0.0500, 0.0510], Y=[-0.0500, 0.0630] m
# Transformation: X_FEM = scale * X_DEM + offset
variable scale_x equal 0.980198019802
variable scale_y equal 0.876106194690
variable offset_x equal 0.000500000000
variable offset_y equal 0.006500000000

# === FIELD APPROXIMATION ===
# 9-peak Gaussian approximation (dynamically selected)
# Peak selection: 70% threshold, 6.0 mm min separation
# Peak width: 3.0 mm (3× FEM grid spacing)
# Field coverage: ~25.9% of gradient energy

# Peak 1 at FEM=(0.0400, -0.0180) m
variable peak0_x equal 0.040000000000
variable peak0_y equal -0.018000000000
variable peak0_gradBx equal -2.536530422864e+04
variable peak0_gradBy equal 2.532375037218e+04
variable peak0_width equal 0.003000000000

variable dx0 atom "(x*v_scale_x+v_offset_x)-v_peak0_x"
variable dy0 atom "(y*v_scale_y+v_offset_y)-v_peak0_y"
variable r2_0 atom "v_dx0*v_dx0+v_dy0*v_dy0"
variable gauss0 atom "exp(-v_r2_0/(2*v_peak0_width*v_peak0_width))"
variable gBx0 atom "v_peak0_gradBx*v_gauss0"
variable gBy0 atom "v_peak0_gradBy*v_gauss0"

# Peak 2 at FEM=(0.0500, -0.0380) m
variable peak1_x equal 0.050000000000
variable peak1_y equal -0.038000000000
variable peak1_gradBx equal 2.447937448273e+04
variable peak1_gradBy equal -2.441206508918e+04
variable peak1_width equal 0.003000000000

variable dx1 atom "(x*v_scale_x+v_offset_x)-v_peak1_x"
variable dy1 atom "(y*v_scale_y+v_offset_y)-v_peak1_y"
variable r2_1 atom "v_dx1*v_dx1+v_dy1*v_dy1"
variable gauss1 atom "exp(-v_r2_1/(2*v_peak1_width*v_peak1_width))"
variable gBx1 atom "v_peak1_gradBx*v_gauss1"
variable gBy1 atom "v_peak1_gradBy*v_gauss1"

# Peak 3 at FEM=(0.0400, -0.0320) m
variable peak2_x equal 0.040000000000
variable peak2_y equal -0.032000000000
variable peak2_gradBx equal -2.397176063672e+04
variable peak2_gradBy equal 2.392564405084e+04
variable peak2_width equal 0.003000000000

variable dx2 atom "(x*v_scale_x+v_offset_x)-v_peak2_x"
variable dy2 atom "(y*v_scale_y+v_offset_y)-v_peak2_y"
variable r2_2 atom "v_dx2*v_dx2+v_dy2*v_dy2"
variable gauss2 atom "exp(-v_r2_2/(2*v_peak2_width*v_peak2_width))"
variable gBx2 atom "v_peak2_gradBx*v_gauss2"
variable gBy2 atom "v_peak2_gradBy*v_gauss2"

# Peak 4 at FEM=(0.0500, 0.0120) m
variable peak3_x equal 0.050000000000
variable peak3_y equal 0.012000000000
variable peak3_gradBx equal 2.353906461220e+04
variable peak3_gradBy equal -2.354822519167e+04
variable peak3_width equal 0.003000000000

variable dx3 atom "(x*v_scale_x+v_offset_x)-v_peak3_x"
variable dy3 atom "(y*v_scale_y+v_offset_y)-v_peak3_y"
variable r2_3 atom "v_dx3*v_dx3+v_dy3*v_dy3"
variable gauss3 atom "exp(-v_r2_3/(2*v_peak3_width*v_peak3_width))"
variable gBx3 atom "v_peak3_gradBx*v_gauss3"
variable gBy3 atom "v_peak3_gradBy*v_gauss3"

# Peak 5 at FEM=(-0.0400, -0.0320) m
variable peak4_x equal -0.040000000000
variable peak4_y equal -0.032000000000
variable peak4_gradBx equal -2.277504056322e+04
variable peak4_gradBy equal -2.274393756683e+04
variable peak4_width equal 0.003000000000

variable dx4 atom "(x*v_scale_x+v_offset_x)-v_peak4_x"
variable dy4 atom "(y*v_scale_y+v_offset_y)-v_peak4_y"
variable r2_4 atom "v_dx4*v_dx4+v_dy4*v_dy4"
variable gauss4 atom "exp(-v_r2_4/(2*v_peak4_width*v_peak4_width))"
variable gBx4 atom "v_peak4_gradBx*v_gauss4"
variable gBy4 atom "v_peak4_gradBy*v_gauss4"

# Peak 6 at FEM=(0.0500, -0.0280) m
variable peak5_x equal 0.050000000000
variable peak5_y equal -0.028000000000
variable peak5_gradBx equal -9.375756072654e+00
variable peak5_gradBy equal -2.699855905330e+04
variable peak5_width equal 0.003000000000

variable dx5 atom "(x*v_scale_x+v_offset_x)-v_peak5_x"
variable dy5 atom "(y*v_scale_y+v_offset_y)-v_peak5_y"
variable r2_5 atom "v_dx5*v_dx5+v_dy5*v_dy5"
variable gauss5 atom "exp(-v_r2_5/(2*v_peak5_width*v_peak5_width))"
variable gBx5 atom "v_peak5_gradBx*v_gauss5"
variable gBy5 atom "v_peak5_gradBy*v_gauss5"

# Peak 7 at FEM=(0.0500, -0.0210) m
variable peak6_x equal 0.050000000000
variable peak6_y equal -0.021000000000
variable peak6_gradBx equal -1.514019100669e+01
variable peak6_gradBy equal -2.671661713997e+04
variable peak6_width equal 0.003000000000

variable dx6 atom "(x*v_scale_x+v_offset_x)-v_peak6_x"
variable dy6 atom "(y*v_scale_y+v_offset_y)-v_peak6_y"
variable r2_6 atom "v_dx6*v_dx6+v_dy6*v_dy6"
variable gauss6 atom "exp(-v_r2_6/(2*v_peak6_width*v_peak6_width))"
variable gBx6 atom "v_peak6_gradBx*v_gauss6"
variable gBy6 atom "v_peak6_gradBy*v_gauss6"

# Peak 8 at FEM=(0.0500, -0.0140) m
variable peak7_x equal 0.050000000000
variable peak7_y equal -0.014000000000
variable peak7_gradBx equal -2.105267949452e+01
variable peak7_gradBy equal -2.602017502370e+04
variable peak7_width equal 0.003000000000

variable dx7 atom "(x*v_scale_x+v_offset_x)-v_peak7_x"
variable dy7 atom "(y*v_scale_y+v_offset_y)-v_peak7_y"
variable r2_7 atom "v_dx7*v_dx7+v_dy7*v_dy7"
variable gauss7 atom "exp(-v_r2_7/(2*v_peak7_width*v_peak7_width))"
variable gBx7 atom "v_peak7_gradBx*v_gauss7"
variable gBy7 atom "v_peak7_gradBy*v_gauss7"

# Peak 9 at FEM=(0.0500, -0.0070) m
variable peak8_x equal 0.050000000000
variable peak8_y equal -0.007000000000
variable peak8_gradBx equal -1.989475873732e+01
variable peak8_gradBy equal -2.526681635037e+04
variable peak8_width equal 0.003000000000

variable dx8 atom "(x*v_scale_x+v_offset_x)-v_peak8_x"
variable dy8 atom "(y*v_scale_y+v_offset_y)-v_peak8_y"
variable r2_8 atom "v_dx8*v_dx8+v_dy8*v_dy8"
variable gauss8 atom "exp(-v_r2_8/(2*v_peak8_width*v_peak8_width))"
variable gBx8 atom "v_peak8_gradBx*v_gauss8"
variable gBy8 atom "v_peak8_gradBy*v_gauss8"

# === TOTAL MAGNETIC FORCE FIELD ===
variable BgradB_x atom "v_gBx0 + v_gBx1 + v_gBx2 + v_gBx3 + v_gBx4 + v_gBx5 + v_gBx6 + v_gBx7 + v_gBx8"
variable BgradB_y atom "v_gBy0 + v_gBy1 + v_gBy2 + v_gBy3 + v_gBy4 + v_gBy5 + v_gBy6 + v_gBy7 + v_gBy8"

# === MAGNETIC FORCES BY PARTICLE TYPE ===
# Type 1 (pts_fine): r=20.0 μm, χ=-3.50e-05 (diamagnetic (repelled))
variable coeff_t1 equal -9.333333328252e-13  # χ·V/μ₀ [m³/H]
variable fx_mag_t1 atom "v_coeff_t1*v_BgradB_x*v_force_mult"
variable fy_mag_t1 atom "v_coeff_t1*v_BgradB_y*v_force_mult"

# Type 2 (pts_medium): r=75.0 μm, χ=-3.50e-05 (diamagnetic (repelled))
variable coeff_t2 equal -4.921874997321e-11  # χ·V/μ₀ [m³/H]
variable fx_mag_t2 atom "v_coeff_t2*v_BgradB_x*v_force_mult"
variable fy_mag_t2 atom "v_coeff_t2*v_BgradB_y*v_force_mult"

# Type 3 (pts_coarse): r=150.0 μm, χ=-3.50e-05 (diamagnetic (repelled))
variable coeff_t3 equal -3.937499997857e-10  # χ·V/μ₀ [m³/H]
variable fx_mag_t3 atom "v_coeff_t3*v_BgradB_x*v_force_mult"
variable fy_mag_t3 atom "v_coeff_t3*v_BgradB_y*v_force_mult"

# Type 4 (pts_vcoarse): r=300.0 μm, χ=-3.50e-05 (diamagnetic (repelled))
variable coeff_t4 equal -3.149999998285e-09  # χ·V/μ₀ [m³/H]
variable fx_mag_t4 atom "v_coeff_t4*v_BgradB_x*v_force_mult"
variable fy_mag_t4 atom "v_coeff_t4*v_BgradB_y*v_force_mult"


# === FORCE RAMP-UP FOR SMOOTH TRANSITION ===
# Forces gradually increase from 0 to full strength over Phase 2
# This prevents instant particle repositioning
# Ramp duration: 100,000 timesteps (1.0 seconds)
variable step_phase2_start equal 150000
variable ramp_duration equal 100000
variable ramp_time equal "(step-v_step_phase2_start)*(step>v_step_phase2_start)"
variable ramp_progress equal "v_ramp_time/v_ramp_duration*(v_ramp_time<v_ramp_duration)+1.0*(v_ramp_time>=v_ramp_duration)"

# === FORCE APPLICATION WITH SMOOTH RAMP ===
# Type 1: Magnetic force with smooth ramp + Damping
variable fx_mag_t1_ramped atom "v_fx_mag_t1*v_ramp_progress"
variable fy_mag_t1_ramped atom "v_fy_mag_t1*v_ramp_progress"
fix mag_force_t1 type1_particles addforce v_fx_mag_t1_ramped v_fy_mag_t1_ramped 0.0
variable vx_damp_t1 atom "-v_damping_gamma*vx"
variable vy_damp_t1 atom "-v_damping_gamma*vy"
fix damp_force_t1 type1_particles addforce v_vx_damp_t1 v_vy_damp_t1 0.0

# Type 2: Magnetic force with smooth ramp + Damping
variable fx_mag_t2_ramped atom "v_fx_mag_t2*v_ramp_progress"
variable fy_mag_t2_ramped atom "v_fy_mag_t2*v_ramp_progress"
fix mag_force_t2 type2_particles addforce v_fx_mag_t2_ramped v_fy_mag_t2_ramped 0.0
variable vx_damp_t2 atom "-v_damping_gamma*vx"
variable vy_damp_t2 atom "-v_damping_gamma*vy"
fix damp_force_t2 type2_particles addforce v_vx_damp_t2 v_vy_damp_t2 0.0

# Type 3: Magnetic force with smooth ramp + Damping
variable fx_mag_t3_ramped atom "v_fx_mag_t3*v_ramp_progress"
variable fy_mag_t3_ramped atom "v_fy_mag_t3*v_ramp_progress"
fix mag_force_t3 type3_particles addforce v_fx_mag_t3_ramped v_fy_mag_t3_ramped 0.0
variable vx_damp_t3 atom "-v_damping_gamma*vx"
variable vy_damp_t3 atom "-v_damping_gamma*vy"
fix damp_force_t3 type3_particles addforce v_vx_damp_t3 v_vy_damp_t3 0.0

# Type 4: Magnetic force with smooth ramp + Damping
variable fx_mag_t4_ramped atom "v_fx_mag_t4*v_ramp_progress"
variable fy_mag_t4_ramped atom "v_fy_mag_t4*v_ramp_progress"
fix mag_force_t4 type4_particles addforce v_fx_mag_t4_ramped v_fy_mag_t4_ramped 0.0
variable vx_damp_t4 atom "-v_damping_gamma*vx"
variable vy_damp_t4 atom "-v_damping_gamma*vy"
fix damp_force_t4 type4_particles addforce v_vx_damp_t4 v_vy_damp_t4 0.0

compute fx_sum_t1 _temp_type1 reduce sum v_fx_mag_t1
compute fy_sum_t1 _temp_type1 reduce sum v_fy_mag_t1
compute fx_sum_t2 _temp_type2 reduce sum v_fx_mag_t2
compute fy_sum_t2 _temp_type2 reduce sum v_fy_mag_t2
compute fx_sum_t3 _temp_type3 reduce sum v_fx_mag_t3
compute fy_sum_t3 _temp_type3 reduce sum v_fy_mag_t3
compute fx_sum_t4 _temp_type4 reduce sum v_fx_mag_t4
compute fy_sum_t4 _temp_type4 reduce sum v_fy_mag_t4

# These variables allow visualization of both forces AND field in ParaView
variable fx_mag_viz atom "(type==1)*v_fx_mag_t1_ramped + (type==2)*v_fx_mag_t2_ramped + (type==3)*v_fx_mag_t3_ramped + (type==4)*v_fx_mag_t4_ramped"
variable fy_mag_viz atom "(type==1)*v_fy_mag_t1_ramped + (type==2)*v_fy_mag_t2_ramped + (type==3)*v_fy_mag_t3_ramped + (type==4)*v_fy_mag_t4_ramped"
variable fz_mag_viz atom "0.0"  # No z-component (2D field)

# Magnetic field magnitude at each particle location
variable B_magnitude atom "sqrt(v_gauss0*v_peak0_gradBx*v_peak0_gradBx + v_gauss0*v_peak0_gradBy*v_peak0_gradBy + v_gauss1*v_peak1_gradBx*v_peak1_gradBx + v_gauss1*v_peak1_gradBy*v_peak1_gradBy + v_gauss2*v_peak2_gradBx*v_peak2_gradBx + v_gauss2*v_peak2_gradBy*v_peak2_gradBy + v_gauss3*v_peak3_gradBx*v_peak3_gradBx + v_gauss3*v_peak3_gradBy*v_peak3_gradBy + v_gauss4*v_peak4_gradBx*v_peak4_gradBx + v_gauss4*v_peak4_gradBy*v_peak4_gradBy + v_gauss5*v_peak5_gradBx*v_peak5_gradBx + v_gauss5*v_peak5_gradBy*v_peak5_gradBy + v_gauss6*v_peak6_gradBx*v_peak6_gradBx + v_gauss6*v_peak6_gradBy*v_peak6_gradBy + v_gauss7*v_peak7_gradBx*v_peak7_gradBx + v_gauss7*v_peak7_gradBy*v_peak7_gradBy + v_gauss8*v_peak8_gradBx*v_peak8_gradBx + v_gauss8*v_peak8_gradBy*v_peak8_gradBy)"

variable B_gradient_mag atom "sqrt(v_BgradB_x*v_BgradB_x + v_BgradB_y*v_BgradB_y)"

# === DIAGNOSTIC VARIABLES ===
# Use these to verify coordinate mapping and field interpolation
variable x_mapped atom "x*v_scale_x+v_offset_x"  # DEM→FEM X coordinate
variable y_mapped atom "y*v_scale_y+v_offset_y"  # DEM→FEM Y coordinate
variable grad_check atom "sqrt(v_BgradB_x*v_BgradB_x+v_BgradB_y*v_BgradB_y)"  # Field gradient magnitude


# === FIELD VISUALIZATION DISABLED ===
# To enable, set create_field_viz=True in preprocessor
# Visualization atoms would show field structure as type 5 particles

print "✓ Magnetic field successfully activated!"
print "  - Force formula: F = (χ·V/μ₀)·(B·∇)B"
print "  - Update frequency: every 100 timesteps"
print "  - Velocity damping: γ = 1.74e-03"
print "  - VTK variables: v_fx_mag, v_fy_mag, v_fz_mag"
print "  - Diagnostic variables: v_x_mapped, v_y_mapped, v_grad_check"
