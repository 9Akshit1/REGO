# === MAGNETIC FORCES BY PARTICLE TYPE ===
# Formula: F = (χ·V/μ₀)·(B·∇)B
# Strategy: Spatially-weighted average force per particle type
# Note: LIGGGHTS limitations require simplified approach


# Type 1: pts_fine
# r=20.0 μm, χ=-3.50e-05, V=3.35e-14 m³
# Coefficient: -9.333333e-13 m³/H

# Spatially-averaged force for Type 1:
# Fx = 5.079858e-07 N, Fy = -2.728657e-08 N
fix magf_t1 type1_particles addforce 5.079857678037e-07 -2.728656851324e-08 0.0

# Single particle gravity: 1.742537e-10 N
# Force magnitude: 5.087181e-07 N
# Force ratio (F_mag/F_grav): 2919.411x


# Type 1: 728 force fixes created
# Expected total force: Fx=5.925069e-02 N, Fy=-3.182664e-03 N
# Expected |F_mag|: 5.933611e-02 N
